# Copy to .env.local for local development, or set these in Vercel's
# Project Settings > Environment Variables for production/preview.
# None of these are required for the site to build or run - each
# feature they gate simply stays inactive until configured.

# Contact page form (src/pages/contact.jsx). A real Formspree form's
# endpoint - https://formspree.io/f/<your form id>. Until set, the
# form renders normally but tells visitors to email connect@vikisol.in
# instead of attempting a submit that would fail.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Newsletter signup (footer, blog pages). A real Mailchimp audience's
# embedded-form POST URL and its hidden anti-bot field name - both
# come from Mailchimp: Audience > Signup forms > Embedded forms.
# Until both are set, the newsletter form doesn't render at all.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
NEXT_PUBLIC_NEWSLETTER_BOT_FIELD=
